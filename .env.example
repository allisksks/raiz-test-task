# Скопируйте в .env и при необходимости поменяйте значения.

# --- PostgreSQL (хранилище данных) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=market_map
POSTGRES_USER=market_map
POSTGRES_PASSWORD=market_map

# Пользователь только на чтение витрин (для BI)
BI_READER_USER=bi_reader
BI_READER_PASSWORD=bi_reader

# --- 1С (OData) ---
# Пусто — загружаются файлы выгрузки из data/samples/onec
ONEC_ODATA_URL=
ONEC_USER=
ONEC_PASSWORD=

# --- Подготовленная база конкурентов (адрес SQLAlchemy) ---
PREPARED_DB_URL=sqlite:///data/samples/prepared/prepared.sqlite

# --- Superset ---
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change-me-to-a-long-random-string
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
